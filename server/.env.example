# Server
PORT=5000
NODE_ENV=development

# Database - Railway provides this automatically when you add PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/taskflow

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
SESSION_SECRET=your_session_secret_change_this_too

# Google OAuth (Google Cloud Console — project: gen-lang-client-0996210991)
# API to enable: "Google People API"
# Credentials: OAuth 2.0 Client ID (Web Application type)
# Authorized redirect URI: http://localhost:5000/api/auth/google/callback  (dev)
#                          https://your-backend.railway.app/api/auth/google/callback  (prod)
GOOGLE_CLIENT_ID=526686430373-9hh77d2vdh3ckj32cdaoll4s3fjt2mbc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Frontend URL (used for CORS & OAuth redirect)
# Development: http://localhost:5173
# Production: https://your-app.railway.app
CLIENT_URL=http://localhost:5173

# Backend URL (used for Google OAuth callback)
# Development: http://localhost:5000
# Production: https://your-backend.railway.app
SERVER_URL=http://localhost:5000
